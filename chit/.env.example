# Chit targets Diana testnet only. VITE_ values are public, never secrets.
# Vite dev/preview forward /lcd to the exact public REST API to avoid CORS.
VITE_QORE_REST_URL=/lcd
QORE_REST_PROXY_TARGET=https://api-testnet.qore.host
# Preserved starter EVM read endpoint; Chit anchors on the native lane instead.
VITE_QORE_EVM_RPC_URL=https://evm-testnet.qore.host
